# TIRA Belle Environment Configuration Template
# Copy this file to .env for production deployment. NEVER commit your actual .env with real secrets.

# Store & Brand Configuration
BUSINESS_NAME="TIRA Belle"
BUSINESS_TAGLINE="Little Layers • Big Love"
BUSINESS_OWNER="Yash Chauhan"
STORE_PHONE="+91-9373484198"
STORE_WHATSAPP="+91-9373484198"
UPI_ID="9373484198@upi"

# Loyalty Program Defaults
LOYALTY_THRESHOLD=5
